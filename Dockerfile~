# syntax=docker/dockerfile:1

# ---- Base ----
FROM node:22-alpine AS base
WORKDIR /app
# Some deps need this for glibc-compatible binaries on Alpine
RUN apk add --no-cache libc6-compat

# ---- Dependencies (cached separately from source) ----
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

# ---- Builder ----
FROM base AS builder
ENV NEXT_TELEMETRY_DISABLED=1
# NEXT_PUBLIC_* is resolved at build time (next.config rewrites + client bundle).
# Empty -> next.config falls back to its hardcoded default.
ARG NEXT_PUBLIC_GBSW_GG_BACKEND_URL
ENV NEXT_PUBLIC_GBSW_GG_BACKEND_URL=$NEXT_PUBLIC_GBSW_GG_BACKEND_URL
COPY --from=deps /app/node_modules ./node_modules
COPY . .
RUN npm run build

# ---- Runner (minimal, non-root) ----
FROM base AS runner
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN addgroup -S -g 1001 nodejs \
 && adduser -S -u 1001 -G nodejs nextjs

# Only the standalone server + static assets are needed at runtime
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs
EXPOSE 3000
CMD ["node", "server.js"]
